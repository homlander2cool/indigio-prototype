# Copy to .env.local and fill in real values. Never commit .env.local.

# Public base URL — used for canonical/OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Credentials for the protected investor portal.
AUTH_EMAIL=
AUTH_PASSWORD=

# Supabase Auth and database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Supabase is the sole application database. Run `supabase/schema.sql` in the
# SQL editor once, then seed the portfolio with `npm run supabase:seed`.

# AI chat assistant — server-side only, never exposed to the browser.
# Works with OpenAI or any compatible API (set AI_BASE_URL to point elsewhere).
# Model used for replies. Small/fast models are plenty for a concierge.
AI_MODEL=gpt-4o-mini
# Optional: override the OpenAI-compatible endpoint (e.g. a local gateway).
# Leave empty to use OpenAI's default.
AI_BASE_URL=

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=production
