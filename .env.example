# Copy to .env.local and fill in real values. Never commit .env.local.

# Public base URL — used for canonical/OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Demo credentials shown on the prototype sign-in screen.
NEXT_PUBLIC_DEMO_EMAIL=demo@indigio.test

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=production
