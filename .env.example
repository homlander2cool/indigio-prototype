# Copy to .env.local and fill in real values. Never commit .env.local.

# Public base URL — used for canonical/OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Credentials for the protected investor portal.
AUTH_EMAIL=
AUTH_PASSWORD=

# Database — the same schema works for both:
#   Local development (SQLite file, created automatically by `npm run db:init`):
#     DATABASE_URL=file:./data/indigio.db
#   Production on Vercel (hosted SQLite via Turso — create one free at
#   https://turso.tech, then run `turso db show <name> --url` and create a token):
#     DATABASE_URL=libsql://your-db-name.turso.io
#     TURSO_AUTH_TOKEN=your-turso-token
# If DATABASE_URL is missing, the app falls back to the local file and the UI
# falls back to seeded data, so the site always loads.
DATABASE_URL=file:./data/indigio.db

# AI chat assistant — server-side only, never exposed to the browser.
# Works with OpenAI or any compatible API (set AI_BASE_URL to point elsewhere).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Model used for replies. Small/fast models are plenty for a concierge.
AI_MODEL=gpt-4o-mini
# Optional: override the OpenAI-compatible endpoint (e.g. a local gateway).
# Leave empty to use OpenAI's default.
AI_BASE_URL=

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=production
